{% extends "base.html.twig" %}
{% block title %}Confirmation identité{% endblock %}
{% block body %}
    <div id="welcome" class="square-center">
    <h1>Confirmez votre connexion</h1>

    <form action="{{ path('2fa_login_check') }}" method="POST">
        <p>Scannez le QR Code avec l'application Google Auth et entrez le code :</p>
        <img src="{{ path('2fa_qrcode') }}" alt=" code QR pour la double authentification" class="qrcode" />
        <div>
            <label for="_auth_code">Code Google Auth :</label>
            <input type="text" name="_auth_code" id="_auth_code" />
        </div>
        <button class="button button-submit">Se connecter</button>
    </form>
    </div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Liste des projets{% endblock %}

{% block body %}
<main>
    <header>
        <div id="current-user">
            <div class="user-initiales">
                {% if app.user %}
                    {% set initiales = app.user.firstName|slice(0,1) ~ app.user.lastName|slice(0,1) %}
                    <div class="avatar">{{ initiales }}</div>
                {% endif %}
            </div>
        </div>
        <div id="title-page">
            <h1>Projets</h1>
        </div>
    </header>
    <div id="content">
        <div id="projects-container">
            {% for project in projects %}
            <article class="card-project">
                <a href="{{path('app_project', {id: project.id})}}">
                <h2>{{project.name}}</h2>
                </a>
                 {% if is_granted('ROLE_PROJECT_MANAGER') %}
                <div class="card-project-icons">
                <a href="{{path('app_project_edit', {id: project.id})}}"><i class="fa-solid fa-pen"></i></a>
                <a href="{{path('app_project_remove', {id: project.id})}}" onclick ="return confirm('Êtes-vous sûr ?')"><i class="fa-solid fa-trash"></i></a>
                </div>
                {% endif %}
            </article>
            {% endfor %}
            {% if is_granted('ROLE_PROJECT_MANAGER') %}
            <article class="card-project">
                <a href="{{path('app_project_new')}}">
                <i class="fa-solid fa-circle-plus add-project-icon"></i>
                <h2>Ajouter un projet</h2>
                </a>
            </article>
            {% endif %}
        </div>
    </div>
    </main>
{% endblock %}

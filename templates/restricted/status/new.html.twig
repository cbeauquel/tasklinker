{% extends 'base.html.twig' %}

{% block title %}Nouveau statut{% endblock %}

{% block body %}
<main>
    <header>
        <div id="current-user">
            <div class="user-initiales">
                {% if app.user %}
                    {% set initiales = app.user.firstName|slice(0,1) ~ app.user.lastName|slice(0,1) %}
                    <div class="avatar">{{ initiales }}</div>
                {% endif %}
            </div>
        </div>
        <div id="title-page">
            <h1>Nouveau status pour le projet {{ project.name }}</h1>
        </div>
    </header>
    <div id="content">
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="button button-submit">Envoyer</button>
        {{ form_end(form) }}
    </div>
</main>

{% endblock %}

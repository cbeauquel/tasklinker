{% extends 'base.html.twig' %}

{% block title %}Ajout d'un Employé{% endblock %}

{% block body %}
<main>
    <header>
        <div id="current-user">
            <div class="user-initiales">
                {% if app.user %}
                    {% set initiales = app.user.firstName|slice(0,1) ~ app.user.lastName|slice(0,1) %}
                    <div class="avatar">{{ initiales }}</div>
                {% endif %}
            </div>
        </div>
            <div id="title-page">
                <h1>Nouveau collaborateur</h1>
            </div>
    </header>
    <div id="content">
        {{ form_start(form) }}
            {{ form_row(form.lastName) }}
            {{ form_row(form.firstName) }}
            {{ form_row(form.email) }}
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.entryDate) }}
            {{ form_row(form.contractType) }}
            {{ form_row(form.roles) }}
        <button type="submit" class="button button-submit">Envoyer</button>
        {{ form_end(form) }}
    </div>
</main>

{% endblock %}
